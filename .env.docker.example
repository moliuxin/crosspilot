# CrossPilot Docker 部署环境变量
# 用法：cp .env.docker.example .env 然后修改以下值（compose 自动读取 .env）

# ── 访问端口 ─────────────────────────────
WEB_PORT=8080

# ── 部署子路径（默认根路径部署，改配置重启即生效，前端无需重建）──
# 应用子路径：/ 或 /crosspilot/（前端页面、静态资源、API 均以其为前缀）
APP_BASE_PATH=/
# API 前缀：留空 = ${APP_BASE_PATH}api/（推荐）。
# 仅当 API 不挂在应用路径下时单独设置，例如 /backend-api/；
# 此时前端必须在构建时注入 VITE_API_BASE_PATH=/backend-api/（见 DEPLOYMENT-DOCKER.md）。
API_BASE_PATH=

# ── PostgreSQL ───────────────────────────
# 密码请只用字母数字（不做 URL 编码）
POSTGRES_USER=crosspilot
POSTGRES_PASSWORD=please-change-me
POSTGRES_DB=crosspilot

# ── 后端安全（生产必改）─────────────────
SITEPILOT_JWT_SECRET=change-me-to-a-long-random-string
SITEPILOT_JWT_EXPIRE_HOURS=72

# ── AI Provider（不配置则使用内置 mock，零外部依赖）──
# LLM：任何 OpenAI 协议兼容服务（DeepSeek / 通义 / vLLM / Ollama / GLM）
SITEPILOT_LLM_PROVIDER=mock
SITEPILOT_LLM_API_KEY=
SITEPILOT_LLM_BASE_URL=https://api.openai.com/v1
SITEPILOT_LLM_MODEL=gpt-4o-mini
# 图像：GLM-Image（智谱开放平台），不配置 key 时生成占位图
SITEPILOT_IMAGE_API_KEY=

# ── 业务策略 ─────────────────────────────
SITEPILOT_FREE_GENERATION_LIMIT=1
SITEPILOT_CORS_ORIGINS=*
