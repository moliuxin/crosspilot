# CrossPilot Docker 部署环境变量
# 用法：cp .env.docker.example .env 然后修改以下值（compose 自动读取 .env）

# ── 访问端口 ─────────────────────────────
WEB_PORT=8080

# ── 构建镜像源（默认国内镜像，海外可覆盖为官方地址）──
# PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.11-slim
# NODE_IMAGE=docker.m.daocloud.io/library/node:20-alpine
# NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
# POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16-alpine
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# NPM_REGISTRY=https://registry.npmmirror.com
# 海外构建示例：
# PYTHON_IMAGE=python:3.11-slim
# NODE_IMAGE=node:20-alpine
# NGINX_IMAGE=nginx:1.27-alpine
# POSTGRES_IMAGE=postgres:16-alpine
# PIP_INDEX_URL=https://pypi.org/simple
# NPM_REGISTRY=https://registry.npmjs.org

# ── 部署子路径（默认根路径部署，改配置重启即生效，前端无需重建）──
# 应用子路径：/ 或 /crosspilot/（前端页面、静态资源、API 均以其为前缀）
APP_BASE_PATH=/
# API 前缀：留空 = ${APP_BASE_PATH}api/（推荐）。
# 仅当 API 不挂在应用路径下时单独设置，例如 /backend-api/；
# 此时前端必须在构建时注入 VITE_API_BASE_PATH=/backend-api/（见 DEPLOYMENT-DOCKER.md）。
API_BASE_PATH=

# ── PostgreSQL ───────────────────────────
# 密码请只用字母数字（默认连接串不做 URL 编码）。
# 如必须使用特殊字符，请设置下面完整的 SITEPILOT_DATABASE_URL（密码需 URL 编码）。
POSTGRES_USER=crosspilot
POSTGRES_PASSWORD=please-change-me
POSTGRES_DB=crosspilot
# SITEPILOT_DATABASE_URL=postgresql+psycopg://crosspilot:url-encoded-password@db:5432/crosspilot

# ── 后端安全（生产必改）─────────────────
SITEPILOT_JWT_SECRET=change-me-to-a-long-random-string
SITEPILOT_JWT_EXPIRE_HOURS=72
# 生产建议关闭自助注册
SITEPILOT_ALLOW_SIGNUP=true

# ── 前端演示站开关 ───────────────────────
# 默认 false：不依赖演示数据库，模板预览使用静态 DemoSection。
# 导入演示数据库后设为 true 并重新构建 web 镜像，启用固定 slug 的 Skill 演示站。
VITE_DEMO_SITES_ENABLED=false

# ── AI Provider（不配置则使用内置 mock，零外部依赖）──
# LLM：任何 OpenAI 协议兼容服务（DeepSeek / 通义 / vLLM / Ollama / GLM）
SITEPILOT_LLM_PROVIDER=mock
SITEPILOT_LLM_API_KEY=
SITEPILOT_LLM_BASE_URL=https://api.openai.com/v1
SITEPILOT_LLM_MODEL=gpt-4o-mini
# 图像：GLM-Image（智谱开放平台），不配置 key 时生成占位图
SITEPILOT_IMAGE_API_KEY=

# ── 业务策略 ─────────────────────────────
SITEPILOT_FREE_GENERATION_LIMIT=1
SITEPILOT_CORS_ORIGINS=*
