# ===== 后端配置（复制为 .env 后按需修改）=====

# 数据库：默认 SQLite；生产可改 PostgreSQL
# SITEPILOT_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/sitepilot

# 跨域：前端地址，多个用逗号分隔；* 表示全部允许
SITEPILOT_CORS_ORIGINS=*

# ===== AI 能力 =====
# mock（默认，无外部依赖，用内置专业模板）| openai（OpenAI 兼容协议）
SITEPILOT_LLM_PROVIDER=mock

# 切真实模型时填写（DeepSeek/通义/OpenAI 均可，改 base_url 与 model 即可）
# SITEPILOT_LLM_PROVIDER=openai
# SITEPILOT_LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# SITEPILOT_LLM_BASE_URL=https://api.deepseek.com/v1
# SITEPILOT_LLM_MODEL=deepseek-chat
